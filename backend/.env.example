# Local development only. Replace the signing-secret placeholder before starting.
MONGO_URI=mongodb://127.0.0.1:27017/contractorfoil_local
JWT_SECRET=replace-with-a-random-local-signing-secret
PORT=5000
CORS_ORIGINS=http://127.0.0.1:5173

# Optional reCAPTCHA v3. Enabling it requires both server fields below.
USE_RECAPTCHA=false
RECAPTCHA_SECRET_KEY=
RECAPTCHA_HOSTNAME=
